#!/usr/bin/env python3
"""okwow-capture: send coding agent sessions to okWOW as chats.

Each app signs in on its own: its first session opens okWOW once to sign that
app in, under the app's name, and the app's okWOW tools (`mcp`, a local relay to
the okWOW MCP server) and its session capture share that sign-in. From then on
every session is uploaded through the okWOW MCP server once it
ends or has been idle for a while, unless the user's rules in okWOW (Settings →
Authorized apps) skip sessions started where it started, or pause capture.
The app running the session is detected, not configured: see APPS. okWOW keeps
each session as one of the user's chats in
its model-neutral format and processes it as it does a chat in the app: a
title, a summary and the memories it learns. Secrets are redacted on this
machine before anything leaves it.

Standard library only, so the hooks run on the system Python.
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import fcntl
import hashlib
import http.server
import json
import os
import re
import secrets
import shutil
import socket
import stat
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable, Iterator, Mapping, Optional

PRODUCTION_SERVER = "https://api.okwow.ai/mcp"
# One sign-in per app, named after it, for its okWOW tools and its session capture.
AGENTS = {"claude": "Claude Code", "codex": "Codex", "gemini": "Gemini CLI"}
# The one sign-in every app once shared; removed once an app signs in on its own.
LEGACY_CLIENT_NAME = "okWOW plugin"
PROTOCOL_VERSION = "2025-06-18"
DEFAULT_IDLE_MINUTES = 30
# A sweep for one ended session waits this long for a running sweep. It runs
# detached, so the hook's own timeout does not bound it; an upload can take this long.
SWEEP_WAIT_SECONDS = 60
# A watcher outlives a session no longer than this; SessionStart sweeps the rest.
WATCH_HOURS = 24
FORGET_DAYS = 30
STRING_CHARS = 50_000
# okWOW's limits on a session's start.
FOLDER_MAX = 1024
REPOSITORY_MAX = 512
MAX_UPLOAD_BYTES = 40 * 1024 * 1024
# A session file larger than this is not read at all.
MAX_SESSION_BYTES = 512 * 1024 * 1024
LOOPBACK = {"127.0.0.1", "localhost", "::1"}

CONFIG_DIR = Path(os.environ.get("OKWOW_CAPTURE_HOME") or Path.home() / ".config" / "okwow")
STATE_DIR = Path(os.environ.get("OKWOW_CAPTURE_STATE") or Path.home() / ".local" / "state" / "okwow")
CONFIG_FILE = CONFIG_DIR / "capture.json"
LEGACY_TOKEN_FILE = CONFIG_DIR / "capture-token.json"
LEGACY_ASKED_FILE = CONFIG_DIR / "capture-asked"
STATE_FILE = STATE_DIR / "capture-state.json"
LOCK_FILE = STATE_DIR / "capture.lock"
SWEEP_LOCK_FILE = STATE_DIR / "capture-sweep.lock"
LOG_FILE = STATE_DIR / "capture.log"
SECRET_FIELDS = ("access_token", "refresh_token", "expires_at")


class CaptureError(Exception):
    pass


# --- files -------------------------------------------------------------------


def private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)


def check_owned(path: Path, private: bool = False) -> None:
    """Refuse a file another user could have written, or, for a private one, read."""
    try:
        info = path.lstat()
    except FileNotFoundError:
        return
    loose = info.st_mode & (0o077 if private else 0o022)
    if stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or loose:
        raise CaptureError(
            f"{path} is not safe to trust (a link, owned by someone else, or open to other users); "
            f"fix it with `chmod {'600' if private else '644'} {path}` or delete it"
        )


def read_json(path: Path, default: Any, private: bool = False) -> Any:
    check_owned(path, private)
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path: Path, data: Any, private: bool = False) -> None:
    private_dir(path.parent)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with contextlib.suppress(FileNotFoundError):
        tmp.unlink()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600 if private else 0o644)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def log_handle() -> int:
    private_dir(STATE_DIR)
    return os.open(LOG_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)


def log(message: str) -> None:
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with os.fdopen(log_handle(), "a") as f:
        f.write(f"{stamp} {message}\n")


@contextlib.contextmanager
def locked(blocking: bool = True, path: Path = LOCK_FILE, wait: float = 0) -> Iterator[bool]:
    """Hold path's lock. Not blocking, it gives up at once, or after `wait` seconds."""
    private_dir(STATE_DIR)
    with open(path, "w") as f:
        deadline = time.time() + wait
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
                break
            except BlockingIOError:
                if time.time() >= deadline:
                    yield False
                    return
                time.sleep(0.1)
        try:
            yield True
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def config() -> dict[str, Any]:
    return read_json(CONFIG_FILE, {})


def plugin_server() -> str:
    """The okWOW server the plugin's MCP relay talks to: OKWOW_MCP_URL, else production."""
    return os.environ.get("OKWOW_MCP_URL") or PRODUCTION_SERVER


def server() -> str:
    return checked_server(config().get("server") or plugin_server())


# --- http --------------------------------------------------------------------


def checked_server(url: str) -> str:
    """Capture talks to okWOW only: https on okwow.ai, or this machine for development."""
    parts = urllib.parse.urlsplit(url)
    host = (parts.hostname or "").lower()
    if parts.scheme == "https" and (host == "okwow.ai" or host.endswith(".okwow.ai")):
        return url
    if parts.scheme in ("http", "https") and host in LOOPBACK:
        return url
    raise CaptureError(f"{parts.scheme}://{host} is not an okWOW server; capture only sends to okwow.ai")


def checked_endpoint(url: str) -> str:
    """An endpoint okWOW handed out: https, or this machine when okWOW itself is local."""
    parts = urllib.parse.urlsplit(url)
    host = (parts.hostname or "").lower()
    if parts.scheme == "https" and host:
        return url
    if parts.scheme == "http" and host in LOOPBACK and urllib.parse.urlsplit(server()).hostname in LOOPBACK:
        return url
    # The path and query are left out: an upload URL carries its signature there.
    raise CaptureError(f"Refusing to send to {parts.scheme}://{host}: not https")


def fetch(
    method: str,
    url: str,
    body: Optional[bytes] = None,
    headers: Optional[dict[str, str]] = None,
    timeout: float = 60,
) -> tuple[int, dict[str, str], bytes]:
    request = urllib.request.Request(checked_endpoint(url), data=body, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, {k.lower(): v for k, v in response.headers.items()}, response.read()
    except urllib.error.HTTPError as error:
        return error.code, {k.lower(): v for k, v in error.headers.items()}, error.read()


def get_json(url: str) -> dict[str, Any]:
    status, _, body = fetch("GET", url, headers={"Accept": "application/json"})
    if status != 200:
        raise CaptureError(f"GET {url} returned {status}")
    return json.loads(body)


def post_form(url: str, fields: dict[str, str]) -> dict[str, Any]:
    status, _, body = fetch(
        "POST",
        url,
        urllib.parse.urlencode(fields).encode(),
        {"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
    )
    data = json.loads(body or b"{}")
    if status != 200:
        raise CaptureError(f"Sign-in refused: {data.get('error_description') or data.get('error') or status}")
    return data


# --- tokens ------------------------------------------------------------------


def token_file(agent: str) -> Path:
    """Holds the app's connection; with the Keychain, its tokens live there instead."""
    return CONFIG_DIR / f"capture-token-{agent}.json"


def asked_file(agent: str) -> Path:
    """Sign-in opens on its own once per app; this records that it did."""
    return CONFIG_DIR / f"capture-asked-{agent}"


def keychain_service(agent: str) -> str:
    return f"okWOW {AGENTS[agent]}"


def use_keychain() -> bool:
    return sys.platform == "darwin" and os.environ.get("OKWOW_CAPTURE_KEYCHAIN") != "0" and bool(shutil.which("security"))


def security(*args: str, stdin: Optional[str] = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["security", *args], input=stdin, text=True, capture_output=True, timeout=15, check=False)


def keychain_write(service: str, account: str, secret: dict[str, Any]) -> None:
    blob = base64.b64encode(json.dumps(secret).encode()).decode()
    # Through stdin, so the tokens never appear in a process listing.
    command = f'add-generic-password -U -s "{service}" -a "{account}" -w "{blob}"\n'
    security("-i", stdin=command)
    if keychain_read(service, account) != secret:
        raise CaptureError("Could not save the okWOW sign-in to the Keychain")


def keychain_read(service: str, account: str) -> dict[str, Any]:
    found = security("find-generic-password", "-s", service, "-a", account, "-w")
    if found.returncode != 0:
        return {}
    try:
        return json.loads(base64.b64decode(found.stdout.strip()))
    except ValueError:
        return {}


def connection(agent: str) -> dict[str, Any]:
    """The app's saved connection with its tokens, wherever they are kept."""
    saved = read_json(token_file(agent), {}, private=True)
    if saved.get("store") == "keychain":
        saved.update(keychain_read(keychain_service(agent), saved.get("server", "")))
    return saved


def store_tokens(agent: str, saved: dict[str, Any], tokens: dict[str, Any]) -> None:
    secret = {
        "access_token": tokens["access_token"],
        "refresh_token": tokens.get("refresh_token") or saved.get("refresh_token"),
        "expires_at": time.time() + float(tokens.get("expires_in") or 300) - 30,
    }
    meta = {k: v for k, v in saved.items() if k not in SECRET_FIELDS}
    if use_keychain():
        keychain_write(keychain_service(agent), meta["server"], secret)
        meta["store"] = "keychain"
        write_json(token_file(agent), meta, private=True)
    else:
        meta["store"] = "file"
        write_json(token_file(agent), {**meta, **secret}, private=True)
    saved.update(secret)


def sign_in_step(agent: str) -> str:
    return f"sign in with `okwow-capture login --agent {agent}`"


def access_token(agent: str, url: str, force_refresh: bool = False) -> str:
    saved = connection(agent)
    if not saved.get("access_token"):
        raise CaptureError(f"{AGENTS[agent]} is not signed in to okWOW; {sign_in_step(agent)}")
    if saved.get("server") != url:
        raise CaptureError(f"{AGENTS[agent]}'s okWOW sign-in is for another server; {sign_in_step(agent)}")
    if force_refresh or time.time() >= saved.get("expires_at", 0):
        if not saved.get("refresh_token"):
            raise CaptureError(f"{AGENTS[agent]}'s okWOW sign-in expired; {sign_in_step(agent)}")
        try:
            tokens = post_form(
                saved["token_endpoint"],
                {
                    "grant_type": "refresh_token",
                    "refresh_token": saved["refresh_token"],
                    "client_id": saved["client_id"],
                    "resource": saved["resource"],
                },
            )
        except CaptureError as error:
            raise CaptureError(f"{AGENTS[agent]}'s okWOW sign-in could not be renewed ({error}); "
                               f"{sign_in_step(agent)}") from error
        store_tokens(agent, saved, tokens)
    return saved["access_token"]


def forget_legacy() -> bool:
    """Remove the sign-in every app once shared; True when there was one."""
    if not LEGACY_TOKEN_FILE.exists():
        return False
    with contextlib.suppress(OSError, ValueError):
        saved = json.loads(LEGACY_TOKEN_FILE.read_text())
        if saved.get("store") == "keychain":
            security("delete-generic-password", "-s", LEGACY_CLIENT_NAME, "-a", str(saved.get("server", "")))
    for path in (LEGACY_TOKEN_FILE, LEGACY_ASKED_FILE):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
    return True


LEGACY_NOTICE = (f'The okWOW plugin no longer uses its old shared sign-in: remove "{LEGACY_CLIENT_NAME}" '
                 "in okWOW under Settings → Authorized apps.")


# --- oauth -------------------------------------------------------------------


def discover(url: str) -> dict[str, Any]:
    parts = urllib.parse.urlsplit(url)
    origin = f"{parts.scheme}://{parts.netloc}"
    resource = get_json(f"{origin}/.well-known/oauth-protected-resource{parts.path}")
    issuer = resource["authorization_servers"][0].rstrip("/")
    return {
        "resource": resource.get("resource", url),
        "metadata": get_json(f"{issuer}/.well-known/oauth-authorization-server"),
    }


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


CONNECTOR_ICON = "M10.001 1.74902C11.9214 1.74903 13.4785 3.30612 13.4785 5.22656C13.4784 6.88929 12.3107 8.27807 10.751 8.62109V10.3027L12.8672 11.8633C13.4145 11.5038 14.0698 11.295 14.7734 11.2949C16.6939 11.2949 18.251 12.852 18.251 14.7725C18.2507 16.6927 16.6937 18.249 14.7734 18.249C12.8534 18.2487 11.2971 16.6925 11.2969 14.7725C11.2969 14.1042 11.4848 13.4792 11.8115 12.9492L10.001 11.6133L8.18945 12.9502C8.51617 13.4801 8.70508 14.1042 8.70508 14.7725C8.70484 16.6926 7.14869 18.2489 5.22852 18.249C3.30838 18.2488 1.75121 16.6926 1.75098 14.7725C1.75098 12.8521 3.30824 11.2951 5.22852 11.2949C5.9324 11.295 6.58735 11.5047 7.13477 11.8643L9.25098 10.3018V8.62109C7.69143 8.27795 6.52356 6.88917 6.52344 5.22656C6.52344 3.30624 8.0807 1.74922 10.001 1.74902ZM5.22852 12.7949C4.13667 12.7951 3.25098 13.6806 3.25098 14.7725C3.25121 15.8642 4.13681 16.7488 5.22852 16.749C6.32027 16.7489 7.20484 15.8642 7.20508 14.7725C7.20508 13.6805 6.32041 12.7951 5.22852 12.7949ZM14.7734 12.7949C13.6817 12.7953 12.7969 13.6807 12.7969 14.7725C12.7971 15.8641 13.6819 16.7487 14.7734 16.749C15.8653 16.749 16.7507 15.8643 16.751 14.7725C16.751 13.6804 15.8655 12.7949 14.7734 12.7949ZM10.001 3.24902C8.90913 3.24922 8.02344 4.13467 8.02344 5.22656C8.02358 6.31834 8.90921 7.20293 10.001 7.20312C11.0929 7.20312 11.9784 6.31846 11.9785 5.22656C11.9785 4.13455 11.093 3.24903 10.001 3.24902Z"
PAGE = """<!doctype html><html lang="en"><meta charset="utf-8">
