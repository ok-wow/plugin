{
  "description": "okWOW session capture: saves your agent sessions as okWOW chats. Each app's first session opens okWOW once to sign that app in; nothing is sent before that.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/okwow-capture\" hook", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/okwow-capture\" hook", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "exec python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/okwow-capture\" hook", "timeout": 10 }] }
    ]
  }
}
